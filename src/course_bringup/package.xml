<?xml version="1.0"?>
<package format="3">
  <name>course_bringup</name>
  <version>0.0.0</version>
  <description>Namespaced patrol launch and pose QoS experiment for PR05.</description>
  <maintainer email="reev1l@users.noreply.github.com">reev1l</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>patrol</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>turtlesim</exec_depend>
  <exec_depend condition="$ROS_DISTRO != jazzy">turtlesim_msgs</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_transport</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
